  "intro_zh": "介绍普通一天：你做什么、同事做什么、大家一起做什么。先学几组高频变化，再识别例外。",
  "lesson_text": [
    {
      "id": "s01",
      "cs": "Ráno vstávám v sedm a doma snídám. Potom pracuju v malé firmě.",
      "zh": "早上我七点起床，在家吃早饭。然后在一家小公司工作。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s02",
      "cs": "Moje kolegyně Eva mluví s lidmi a já píšu krátké zprávy.",
      "zh": "我的同事伊娃和人交谈，我写简短消息。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s03",
      "cs": "Petr má obchod. Prodává čaj, kávu a malé dárky.",
      "zh": "彼得有一家商店，卖茶、咖啡和小礼物。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s04",
      "cs": "Co děláš ty? Studuješ, nebo pracuješ?",
      "zh": "你做什么？你在学习还是工作？",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s05",
      "cs": "Teď pracuju, ale večer se učím česky. Každý den čtu krátký text.",
      "zh": "现在我工作，不过晚上学捷语。每天读一段短文。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s06",
      "cs": "My obvykle obědváme spolu. Eva pije vodu a já piju čaj.",
      "zh": "我们通常一起吃午饭。伊娃喝水，我喝茶。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s07",
      "cs": "Odpoledne máme čas na telefon. Potřebujeme jednu informaci.",
      "zh": "下午我们有时间打电话。我们需要一条信息。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s08",
      "cs": "Večer už nepracuju. Vařím, poslouchám hudbu a odpočívám.",
      "zh": "晚上我不工作了。我做饭、听音乐、休息。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s09",
      "cs": "O víkendu obvykle nepracuju. Mám čas na přátele a na rodinu.",
      "zh": "周末我通常不工作，有时间陪朋友和家人。",
      "note_zh": "把新信息与前文连接，再独立复述。"
    }
  ],
  "grammar": [
    {
      "id": "verb-present-patterns",
      "rule_zh": "同一个动作，末尾随着“谁”变化。",
      "detail_zh": "dělat：dělám, děláš, dělá, děláme, děláte, dělají；mluvit：mluvím, mluvíš, mluví, mluvíme, mluvíte, mluví；pracovat：pracuju/pracuji, pracuješ, pracuje, pracujeme, pracujete, pracují/pracujou（后者口语）。人称顺序是我、你、他/她、我们、你们/您、他们。常见mít：mám, máš, má, máme, máte, mají。",
      "examples": [
        {
          "cs": "Pracuju doma.",
          "zh": "我在家工作。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "Pracujeme spolu.",
          "zh": "我们一起工作。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "用不定式直接代替所有人称，如já pracovat。"
      ],
      "exceptions": [
        "不是所有动词都能照一组套：číst→čtu, čteš；pít→piju, piješ。"
      ],
      "term": "现在时人称变化"
    },
    {
      "id": "present-context",
      "rule_zh": "现在时既可说此刻，也可说日常习惯，靠时间词分清。",
      "detail_zh": "Teď čtu是现在在读，Každý den čtu是每天读。捷语不需要复制中文“正在”或英语进行时结构才能说明进行中的动作。否定通常ne-加动词：nepracuju、nemám。",
      "examples": [
        {
          "cs": "Teď píšu.",
          "zh": "我现在在写。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "Každý den píšu.",
          "zh": "我每天写。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "以为出现现在时就一定是正在此刻发生。"
      ],
      "exceptions": [
        "有些现在形式的完成体表示未来，A2系统学体后再处理。"
      ],
      "term": "时间语境"
    }
  ],
