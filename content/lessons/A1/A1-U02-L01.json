  "intro_zh": "整理一个房间，能指出哪件东西是什么、属于哪一类。语法性别是配词规则，不是说物品真的有男女。",
  "lesson_text": [
    {
      "id": "s01",
      "cs": "Tady je náš malý byt. To je kuchyň a vedle je pokoj.",
      "zh": "这里是我们的小公寓。这是厨房，旁边是房间。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s02",
      "cs": "Ten stůl je nový, ale ta židle je stará. To okno je velké.",
      "zh": "那张桌子是新的，那把椅子是旧的。那扇窗很大。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s03",
      "cs": "Na stole je telefon, kniha a malé rádio. Telefon je černý.",
      "zh": "桌上有电话、书和一个小收音机。电话是黑色的。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s04",
      "cs": "Kniha je česká. Rádio je bílé a velmi lehké.",
      "zh": "书是捷语的。收音机是白色的，而且很轻。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s05",
      "cs": "Kdo je na fotografii? To je můj kolega Pavel a moje kolegyně Eva.",
      "zh": "照片上是谁？这是我的同事帕维尔和女同事伊娃。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s06",
      "cs": "Pavel je nový učitel. Eva je dobrá lékařka.",
      "zh": "帕维尔是新老师。伊娃是好医生。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s07",
      "cs": "Je ten pokoj volný? Ano, je volný. Ta kuchyň je společná.",
      "zh": "那个房间空着吗？是的，空着。厨房是共用的。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s08",
      "cs": "Dobře, děkuju. Teď už vím, co je tady nové a co staré.",
      "zh": "好的，谢谢。现在我知道这里什么是新的，什么是旧的。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    }
  ],
  "grammar": [
    {
      "id": "noun-gender",
      "rule_zh": "名词带着自己的类别，前后的指示词和形容词跟着换。",
      "detail_zh": "主格单数常见组合：ten nový stůl（阳性），ta nová kniha（阴性），to nové okno（中性）。辅音结尾常为阳性，-a常阴性，-o/-í常中性，只是线索。kuchyň、věc等辅音结尾却是阴性；kolega是阳性有生，不能只看-a。",
      "examples": [
        {
          "cs": "ten nový telefon",
          "zh": "那部新电话",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "ta nová židle",
          "zh": "那把新椅子",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "to nové rádio",
          "zh": "那个新收音机",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "把所有-a结尾词都判为阴性。"
      ],
      "exceptions": [
        "学习词汇时一起记ten/ta/to与常用词形，例外不能靠猜。"
      ],
      "term": "性别与形容词一致"
    },
    {
      "id": "animacy-intro",
      "rule_zh": "阳性还分“有生”和“无生”，后面会影响词形。",
      "detail_zh": "muž、učitel、kolega属阳性有生；stůl、telefon属阳性无生。语法有生性不是现实生命的完整分类：主要用于一组变格与一致规则。先建立分类，A1宾格和A2复数再用。",
      "examples": [
        {
          "cs": "To je nový učitel.",
          "zh": "这是新老师。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "To je nový telefon.",
          "zh": "这是新电话。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "把树木等所有活物自动按阳性有生处理。"
      ],
      "exceptions": [
        "女性人物仍属于阴性；“有生/无生”的这组对立主要指阳性语法。"
      ],
      "term": "有生性"
    }
  ],
