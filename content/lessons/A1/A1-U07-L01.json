  "intro_zh": "和邻居聊自己的生活，能说关系、工作和爱好；真实情况由你填写，不把教学人物当成你的履历。",
  "lesson_text": [
    {
      "id": "s01",
      "cs": "To je moje rodina. Na fotografii je moje sestra, její manžel a jejich dcera.",
      "zh": "这是我的家人。照片上是我姐姐、她丈夫和他们的女儿。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s02",
      "cs": "Sestra se jmenuje Lin. Pracuje v obchodě a má ráda svou práci.",
      "zh": "姐姐叫琳，她在商店工作，喜欢自己的工作。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s03",
      "cs": "Její manžel je kuchař. Rád vaří, ale doma někdy vaří i sestra.",
      "zh": "她丈夫是厨师，喜欢做饭，不过家里有时也由姐姐做饭。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s04",
      "cs": "Jejich dcera chodí do školy. Ráda čte a kreslí.",
      "zh": "他们的女儿上学，喜欢阅读和画画。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s05",
      "cs": "Já bydlím sám. Ve volném čase rád chodím ven a poslouchám hudbu.",
      "zh": "我一个人住，空闲时喜欢出门、听音乐。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s06",
      "cs": "Můj kamarád Pavel má rád sport. Každou sobotu hraje fotbal.",
      "zh": "我的朋友帕维尔喜欢运动，每周六踢足球。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s07",
      "cs": "Nemám moc času na sport, ale rád se s ním procházím.",
      "zh": "我运动时间不多，但喜欢和他一起散步。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s08",
      "cs": "A co vy? Máte sourozence? Co rád děláte o víkendu?",
      "zh": "您呢？有兄弟姐妹吗？周末喜欢做什么？",
      "note_zh": "这里礼貌询问一位男性；询问一位女性用Co ráda děláte o víkendu?，询问多人可用rádi（含男性有生）或rády（全女性）。敬称的动词děláte用复数，rád/ráda仍与被称呼的一人一致。"
    },
    {
      "id": "s09",
      "cs": "O osobních věcech mluvíme jen tehdy, když chceme.",
      "zh": "私人事情只有我们愿意时才聊。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    }
  ],
  "grammar": [
    {
      "id": "possessive-basic",
      "rule_zh": "“我的”跟被拥有的东西配合，不跟拥有者的性别配合。",
      "detail_zh": "můj bratr、moje sestra、moje dítě；tvůj/tvoje同理。náš byt、naše rodina；váš telefon、vaše práce。jeho（他的）和jejich（他们的）不随被拥有物这样变；její（她的）有自己的变化。",
      "examples": [
        {
          "cs": "můj telefon",
          "zh": "我的电话",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "moje kniha",
          "zh": "我的书",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "因为说话者是男性就所有东西都配můj。"
      ],
      "exceptions": [
        "svůj表示句子主语自己的，A2系统展开，不能总用můj替代。"
      ],
      "term": "物主词入门"
    },
    {
      "id": "likes-rad",
      "rule_zh": "喜欢物品用mít rád，喜欢做某事用rád加动作。",
      "detail_zh": "男性说Mám rád čaj、Rád vařím；女性说Mám ráda čaj、Ráda vařím。复数含男性有生常rádi，全女性rády。Rád čtu不用再加mám。",
      "examples": [
        {
          "cs": "Mám rád hudbu.",
          "zh": "我喜欢音乐（男性说）。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "Ráda čtu.",
          "zh": "我喜欢阅读（女性说）。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "说Mám rád čtu会把两种结构混起来。"
      ],
      "exceptions": [
        "rád表达喜好或乐意，不等于恋爱中的爱。"
      ],
      "term": "喜好表达"
    }
  ],
