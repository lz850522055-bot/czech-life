  "listening": {
    "script": [
      {
        "cs": "Prodejce nám odpověděl, že zboží je dostupné jen v internetovém obchodě. Kamenná prodejna ho nemá. Cena je nižší, ale doprava se platí zvlášť. Než nabídku označíme za výhodnou, musíme spočítat celkové náklady.",
        "zh": "卖家回复只网店有货，实体店没有。价格低但运费另付；称划算前需算总成本。",
        "note_zh": ""
      }
    ],
    "focus_zh": "听出人、地点、性质与成本，不只围绕相似词根猜。",
    "source": "original"
  },
  "pronunciation": {
    "focus_zh": "prodejce / prodejna 在词尾处放慢核对；dostupný 的长 ý 与 dostupnost 结尾辅音群清楚说出。",
    "contrast": [
      {
        "a": "prodejce",
        "b": "prodejna",
        "note_zh": "相同开头，不同词尾对应不同角色。"
      }
    ],
    "task_zh": "先听一句，再按意义块跟读；录下自然语速版本，对照长短元音、句中停顿和关键词。不要追求机械加速。"
  },
