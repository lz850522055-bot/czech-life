  "listening": {
    "script": [
      {
        "cs": "Na včerejší schůzce jsme se dohodli na novém termínu. Já jsem vám ho poslal večer. Mně ale zatím žádné potvrzení nepřišlo. Můžete mi prosím říct, zda vám zpráva dorazila?",
        "zh": "昨天会上我们定了新时间，我晚上发给您了。但我还没收到确认，您能告诉我消息是否到了吗？",
        "note_zh": ""
      }
    ],
    "focus_zh": "跟随指代：ho 指 termín；mi/mně 是说话人；找出是否收到确认。",
    "source": "original"
  },
  "pronunciation": {
    "focus_zh": "先拍一次第一意义块，再把 jsem vám ho 连读成轻读组；不把每个词都拖成相同长度。",
    "contrast": [
      {
        "a": "mi",
        "b": "mně",
        "note_zh": "轻读形式与强调形式，不只是音量不同。"
      }
    ],
    "task_zh": "先听一句，再按意义块跟读；录下自然语速版本，对照长短元音、句中停顿和关键词。不要追求机械加速。"
  },
