  "intro_zh": "第一次真实交流只需要抓住意图、回应、确认。你可以先用短句，也可以主动请对方写下来。",
  "lesson_text": [
    {
      "id": "s01",
      "cs": "Dobrý den.",
      "zh": "您好。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s02",
      "cs": "Dobrý den. Co si přejete?",
      "zh": "您好，您需要什么？",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s03",
      "cs": "Čaj, prosím.",
      "zh": "请给茶。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s04",
      "cs": "Černý, nebo zelený?",
      "zh": "红茶还是绿茶？",
      "note_zh": "捷语černý čaj字面为黑茶，通常指中文红茶。"
    },
    {
      "id": "s05",
      "cs": "Zelený, prosím.",
      "zh": "请给绿茶。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s06",
      "cs": "S cukrem?",
      "zh": "加糖吗？",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s07",
      "cs": "Ne, děkuju. Bez cukru.",
      "zh": "不，谢谢，不加糖。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s08",
      "cs": "Tady máte.",
      "zh": "给您。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s09",
      "cs": "Děkuju. Na shledanou.",
      "zh": "谢谢，再见。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s10",
      "cs": "Na shledanou.",
      "zh": "再见。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    }
  ],
  "grammar": [
    {
      "id": "repair-basic",
      "rule_zh": "先听出对方在问什么，再用最短够用的话回应。",
      "detail_zh": "ne是否定，ano是肯定；nebo表示“还是/或者”，不是“不”。问你černý, nebo zelený时是在给两个选项；问s cukrem时是确认加不加糖。短答zelený在明确语境里成立，不必每次拼完整长句。",
      "examples": [
        {
          "cs": "Ne, děkuju.",
          "zh": "不，谢谢。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "Černý, nebo zelený?",
          "zh": "红茶还是绿茶？",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "把nebo中的ne当成否定。"
      ],
      "exceptions": [
        "短答依赖上下文；陌生人没听到前文时需补名词。"
      ],
      "term": "对话意图与省略"
    },
    {
      "id": "chunk-basic",
      "rule_zh": "把礼貌请求作为一整块记，后面再换内容。",
      "detail_zh": "X, prosím适合点一个明确物品；bez cukru是一块“不加糖”，现在先会用。A1/A2会解释为什么cukr变成cukru。你不知道某个词时说Nerozumím，再请求pomalu或napište。",
      "examples": [
        {
          "cs": "Vodu, prosím.",
          "zh": "请给水。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "Nerozumím.",
          "zh": "我不懂。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "以为所有名词放在请求中都不变形。"
      ],
      "exceptions": [
        "Vodu的词形与voda不同，这里只作语块预习，不能推成所有词加u。"
      ],
      "term": "语块学习"
    }
  ],
