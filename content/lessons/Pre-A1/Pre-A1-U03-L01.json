  "intro_zh": "先把可理解的声音练出来；ř可以分步练，不必因为一个音停住整套学习。",
  "lesson_text": [
    {
      "id": "s01",
      "cs": "Cena. Čaj.",
      "zh": "价格。茶。",
      "note_zh": "c与č的阻气位置不同。"
    },
    {
      "id": "s02",
      "cs": "Rada. Řada.",
      "zh": "建议。一排/队列。",
      "note_zh": "r与ř不同。"
    },
    {
      "id": "s03",
      "cs": "Tři. Čtyři.",
      "zh": "三。四。",
      "note_zh": "先听完整词，不在辅音群之间加元音。"
    },
    {
      "id": "s04",
      "cs": "Ruka. Řeka.",
      "zh": "手。河。",
      "note_zh": "这两词用于声音练习，不是最小对立词。"
    },
    {
      "id": "s05",
      "cs": "Krk. Vlk.",
      "zh": "脖子。狼。",
      "note_zh": "r或l能构成音节核心。"
    },
    {
      "id": "s06",
      "cs": "Tady je řeka.",
      "zh": "这里有条河。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s07",
      "cs": "Prosím tři čaje.",
      "zh": "请给三杯茶。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s08",
      "cs": "Řekněte to pomalu, prosím.",
      "zh": "请慢慢说。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    }
  ],
  "grammar": [
    {
      "id": "consonant-place",
      "rule_zh": "辅音靠嘴里哪儿挡气来区分，不靠额外加一个元音。",
      "detail_zh": "c是前齿龈塞擦音；č在更靠后的位置。r靠舌尖短促颤动；ř在颤动同时有较强摩擦。练ř时先找r的位置，再使气流更集中，不要硬卷舌或把它拆成r加ž两个完整音节。",
      "examples": [
        {
          "cs": "rada",
          "zh": "建议",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "řada",
          "zh": "一排",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "把ř读成两个音节。"
      ],
      "exceptions": [
        "教材的口型说明不能诊断个人发音障碍；困难时先做辨听与短时模仿。"
      ],
      "term": "发音部位"
    },
    {
      "id": "syllabic-rl",
      "rule_zh": "有些词没有元音字母，r或l仍能撑起一个音节。",
      "detail_zh": "krk和vlk可以成为完整词，不必在中间插入a或e。先慢慢保持连续气流，再恢复整词节奏。h是喉部的浊擦音；ch主要在舌后与软腭附近摩擦，不是同一个音的两个拼法。",
      "examples": [
        {
          "cs": "krk",
          "zh": "脖子",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "vlk",
          "zh": "狼",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "hora",
          "zh": "山",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "chata",
          "zh": "小屋",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "把krk念成有两个额外元音的多音节词。"
      ],
      "exceptions": [
        "语流中会有细微过渡声，不等于应主动增加独立元音。"
      ],
      "term": "成音节辅音"
    }
  ],
