  "intro_zh": "你在消息里看到díky，却按普通d来念。本课先理解字母组合如何提示舌位，再认识拼写不能只靠听。",
  "lesson_text": [
    {
      "id": "s01",
      "cs": "Díky. Dítě. Nic.",
      "zh": "谢谢。孩子。没有什么。",
      "note_zh": "本族词中di/ti/ni常提示软辅音。"
    },
    {
      "id": "s02",
      "cs": "Dým. Ty. Nyní.",
      "zh": "烟。你。现在。",
      "note_zh": "dy/ty/ny中的辅音保持硬读。"
    },
    {
      "id": "s03",
      "cs": "Děkuju. Těší mě.",
      "zh": "谢谢。很高兴认识您。",
      "note_zh": "dě、tě、mě各有固定拼读规律。"
    },
    {
      "id": "s04",
      "cs": "Běží. Pět. Věc.",
      "zh": "他/她在跑。五。事情/物品。",
      "note_zh": "bě、pě、vě分别有j过渡。"
    },
    {
      "id": "s05",
      "cs": "Město.",
      "zh": "城市。",
      "note_zh": "mě通常读出m后接ň的组合。"
    },
    {
      "id": "s06",
      "cs": "To je nové město.",
      "zh": "这是一座新的城市。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s07",
      "cs": "Díky, už rozumím.",
      "zh": "谢谢，我现在懂了。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s08",
      "cs": "Napište to, prosím.",
      "zh": "请把它写下来。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    }
  ],
  "grammar": [
    {
      "id": "soft-dtn",
      "rule_zh": "本族词里的di、ti、ni通常让前面的辅音变软。",
      "detail_zh": "di/dí读ď加i/í，ti/tí读ť加i/í，ni/ní读ň加i/í；dy/ty/ny不发生这组软化。i与y本身通常不是两套不同元音，拼写差别常提示前辅音或词形关系。",
      "examples": [
        {
          "cs": "díky",
          "zh": "谢谢",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "dým",
          "zh": "烟",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "nic",
          "zh": "没有什么",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "为了i/y硬造两种完全不同元音。"
      ],
      "exceptions": [
        "外来词如diktát、titul可能硬读，不能把本族词规则硬套所有词。"
      ],
      "term": "软硬辅音与i/y"
    },
    {
      "id": "letter-e-caron",
      "rule_zh": "ě要连着前一个辅音看，不能单独读成一种新元音。",
      "detail_zh": "dě/tě/ně读软辅音加e；bě/pě/vě通常读b/p/v加je；mě通常读mňe。词例děkuju、pět、věc、město先作为完整声音块练。",
      "examples": [
        {
          "cs": "pět",
          "zh": "五",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "město",
          "zh": "城市",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "把mě只念成me，或把ě当长é。"
      ],
      "exceptions": [
        "ě的拼写受词源和构词规则影响；本课只建立常用组合。"
      ],
      "term": "字母ě"
    }
  ],
