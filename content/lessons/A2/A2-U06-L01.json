  "intro_zh": "给搬运的人说明东西放哪里，自己从哪里走到哪里。关键是区分状态、目标方向和来源。",
  "lesson_text": [
    {
      "id": "s01",
      "cs": "V sobotu se stěhujeme do nového bytu. Kamarádi nám pomáhají, ale nejdřív musíme vysvětlit, kam které věci patří.",
      "zh": "周六我们搬进新公寓，朋友来帮忙，但先要说明每件东西放哪。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s02",
      "cs": "Velký stůl dejte do kuchyně. Malý stolek postavte do pokoje pod okno. Židle mohou zůstat u dveří, dokud nebude hotovo.",
      "zh": "大桌放厨房，小桌放房间窗下。搬完前椅子可以先留门口。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s03",
      "cs": "Krabice s knihami položte na zem vedle skříně. Prosím nedávejte je na postel, protože jsou těžké a špinavé.",
      "zh": "书箱放地上柜子旁，请别放床上，因为很重又脏。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s04",
      "cs": "Obrazy zatím stojí za skříní. Později je pověsíme na zeď nad pohovku. Jedna police už visí nad stolem.",
      "zh": "画暂时靠在柜后，之后挂在沙发上方的墙上。有个架子已经挂在桌上方。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s05",
      "cs": "Petr teď jede autem z obchodu. Vezl staré krabice pryč a přiveze nám čistou vodu.",
      "zh": "彼得现在从商店开车过来，他把旧箱子运走，还会给我们带干净的水。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s06",
      "cs": "Já obvykle chodím do obchodu pěšky, protože je blízko. Dnes tam ale pojedu autem pro další věci.",
      "zh": "我通常步行去商店，因为近，但今天要开车去拿更多东西。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s07",
      "cs": "Nový byt je mezi parkem a školou. Z práce k němu jezdím autobusem, ale do parku chodím pěšky.",
      "zh": "新公寓在公园和学校之间，我下班坐公交去公寓，但去公园步行。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s08",
      "cs": "Když všechno stojí na správném místě, můžeme si sednout ke stolu a společně si odpočinout.",
      "zh": "东西放对位置后，我们就能到桌旁坐下，一起休息。",
      "note_zh": "先理解整句意图，再回看本课规律。"
    },
    {
      "id": "s09",
      "cs": "Než odjedeme, ještě zkontrolujeme, že v autě nezůstaly žádné malé věci.",
      "zh": "离开前还要检查车里没留下小物品。",
      "note_zh": "把新信息与前文连接，再独立复述。"
    }
  ],
  "grammar": [
    {
      "id": "spatial-cases",
      "rule_zh": "问“放到哪”与“已经在哪”时，介词可能相同，格却不同。",
      "detail_zh": "na stůl/na zeď为目标方向+4，na stole/na zdi为静态位置+6；pod stůl/nad pohovku/za skříň+4表示移动目标；pod stolem/nad pohovkou/za skříní+7表示静态位置。do kuchyně+2，v kuchyni+6。",
      "examples": [
        {
          "cs": "Položím knihu na stůl.",
          "zh": "我把书放上桌。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "Kniha je na stole.",
          "zh": "书在桌上。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "只看句子有移动动词就统一4格：chodím v parku仍是“在公园内走”。"
      ],
      "exceptions": [
        "决定的是关系和介词，不是动词是否“动”；v+4也有其他用途。"
      ],
      "term": "方位介词的格"
    },
    {
      "id": "motion-once-habit",
      "rule_zh": "一次朝一个方向去，和经常这样去，常用不同动词。",
      "detail_zh": "现在一次步行jdu，习惯chodím；一次乘车jedu，习惯jezdím。每周chodím do školy；此刻jdu do školy。来源：z obchodu，从商店；od kamaráda，从朋友处；目标：k domu，朝房子附近。",
      "examples": [
        {
          "cs": "Teď jedu domů.",
          "zh": "我现在乘车回家。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        },
        {
          "cs": "Každý den jezdím autobusem.",
          "zh": "我每天坐公交。",
          "note_zh": "先理解整句意图，再回看本课规律。"
        }
      ],
      "pitfalls": [
        "用jdu表达每天往返所有场景。"
      ],
      "exceptions": [
        "多方向运动和带前缀动词B1继续；这里先建立单次与习惯。"
      ],
      "term": "运动动词基础对立"
    }
  ],
