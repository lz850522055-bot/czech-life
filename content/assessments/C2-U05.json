  "title_zh": "互相矛盾的证据，怎样综合而不和稀泥：新情境检验",
  "version": "2026.10.22.1",
  "unseen_text": [
    {
      "cs": "Výrobce uvádí rychlejší sestavení výrobku v dílně. Servis hlásí více času stráveného opravami po dodání. Zákazníci oceňují nižší cenu, ale část z nich se do hodnocení nezapojila. Oba časové údaje se týkají jiných fází a nejsou měřeny stejným způsobem.",
      "zh": "制造环节更快，售后更耗时，部分客户喜低价但评价有缺席；时间属不同阶段且方法不一。"
    }
  ],
  "exercises": [
    {
      "type": "choice",
      "prompt_zh": "能否仅凭制造更快说总效率更高？",
      "stimulus_cs": "",
      "answer": "a",
      "explanation_zh": "不能跳阶段。",
      "skill_ids": [
        "reading"
      ],
      "knowledge_points": [
        "c2-conflict-taxonomy",
        "c2-inference-link"
      ],
      "error_category": "comprehension",
      "options": [
        {
          "id": "a",
          "text": "不能，需看其他阶段与方法"
        },
        {
          "id": "b",
          "text": "能，第一阶段决定全部"
        },
        {
          "id": "c",
          "text": "不能，因为服务一定全部失败"
        }
      ],
      "scoring_basis": "封闭题以答案核对；解析说明本题边界。",
      "id": "C2-U05-CHECK-E01"
