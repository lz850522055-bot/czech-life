  "title_zh": "被突然追问时，保住问题的边界：新情境检验",
  "version": "2026.10.22.1",
  "unseen_text": [
    {
      "cs": "Tazatel: Když doporučujete ověřování, znamená to, že nevěříte žádnému odborníkovi? Host má vysvětlit rozdíl mezi odmítáním odbornosti a kontrolou podkladů, ale nesmí tvrdit, že každý člověk zvládne sám posoudit každý obor.",
      "zh": "问者把建议核查等同不信专家；需区分但不能宣称人人能独立评所有专业。"
    }
  ],
  "exercises": [
    {
      "type": "choice",
      "prompt_zh": "问题混淆了哪两件事？",
      "stimulus_cs": "",
      "answer": "a",
      "explanation_zh": "前提过度二分。",
