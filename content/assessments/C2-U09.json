  "title_zh": "把统计结论讲给需要做事的人：新情境检验",
  "version": "2026.10.22.1",
  "unseen_text": [
    {
      "cs": "Při zkoušce trvaly čtyři opravy dvě, dvě, čtyři a osm hodin. Zpráva uvádí průměr čtyři hodiny. Čas čekání na díly se měřil zvlášť. Reklamní věta však slibuje opravu včetně dílů každému do čtyř hodin.",
      "zh": "四次维修2、2、4、8小时均值4，等待零件另计；广告却承诺每人含零件四小时内。"
    }
  ],
  "exercises": [
    {
      "type": "choice",
      "prompt_zh": "均值算错了吗？",
      "stimulus_cs": "",
      "answer": "a",
      "explanation_zh": "16/4=4；错误属范围与量化。",
      "skill_ids": [
        "reading"
      ],
      "knowledge_points": [
        "c2-technical-analogy",
        "c2-conditions-and-aggregation"
      ],
      "error_category": "comprehension",
      "options": [
        {
          "id": "a",
          "text": "没有，错在把范围外内容变承诺"
        },
        {
          "id": "b",
          "text": "算错，应为8"
        },
        {
          "id": "c",
          "text": "算错，应为2"
        }
