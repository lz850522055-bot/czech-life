  "level": "C1",
  "unit_id": "C1-U01",
  "title_zh": "一座城市的价值由谁决定：新情境检验",
  "version": "2026.10.22.1",
  "unseen_text": [
    {
      "cs": "Obec chce přeměnit nevyužívanou školu na sdílené dílny. Řemeslníci návrh vítají, ale sousedé se obávají hluku. Správce slibuje klidný provoz, zatím však nepředložil pravidla. Jeden obyvatel navrhuje zkušební otevření se zveřejněným rozvrhem a postupem pro stížnosti.",
      "zh": "闲置学校拟改共享工坊。手艺人欢迎，邻居担心噪声；管理员只口头保证安静，居民提出试运行、公开时间表与投诉流程。"
    }
  ],
  "exercises": [
    {
      "type": "choice",
      "prompt_zh": "哪个信息仍未得到具体支持？",
      "stimulus_cs": "",
      "answer": "b",
      "explanation_zh": "保证与可执行规则不是同一件事。",
      "skill_ids": [
        "reading"
      ],
      "knowledge_points": [
        "c1-argument-criteria",
        "c1-nominalization"
      ],
      "error_category": "comprehension",
      "options": [
        {
          "id": "a",
          "text": "有人担心噪声"
        },
        {
          "id": "b",
          "text": "运营会安静"
        },
        {
          "id": "c",
          "text": "有人提议试运行"
        }
      ],
      "scoring_basis": "封闭题以答案核对；解析说明本题边界。",
      "id": "C1-U01-CHECK-E01"
    },
    {
      "type": "writing",
      "prompt_zh": "拟两项可检查条件，避免“绝对不能有噪声”这种无法工作的口号。",
      "stimulus_cs": "",
      "answer": "Hlučné práce budou povoleny jen ve zveřejněných hodinách. Správce odpoví na stížnost do dohodnuté lhůty.",
      "explanation_zh": "限制须可观察且责任明确。",
      "skill_ids": [
        "writing"
      ],
      "knowledge_points": [
        "c1-argument-criteria",
        "c1-nominalization"
      ],
      "error_category": "comprehension",
      "rubric": [
        "回应具体任务，信息不失真",
