  "title_zh": "“不一定”与“不允许”，差的是整个判断：新情境检验",
  "version": "2026.10.22.1",
  "unseen_text": [
    {
      "cs": "Zpráva: Ne všechny pobočky už přijímají nové žádosti. Pouze jižní pobočka potvrdila rozšíření otevírací doby. U severní zatím neznáme termín změny.",
      "zh": "并非所有网点已经接新申请；只有南网点确认延时开放；北网点变更日期未知。"
    }
  ],
  "exercises": [
    {
      "type": "choice",
      "prompt_zh": "能否断言北网点永远不变更？",
      "stimulus_cs": "",
      "answer": "c",
      "explanation_zh": "未知当前日期不等于永久不变。",
      "skill_ids": [
        "reading"
      ],
      "knowledge_points": [
        "c2-negation-scope",
        "c2-focus-modal-time"
      ],
      "error_category": "comprehension",
      "options": [
