  "unseen_text": [
    {
      "cs": "Vedoucí kurzu: Zpočátku jsme úspěch měřili počtem přihlášek. Později jsme zjistili, že část lidí kurz vůbec nezačala. Nyní oddělujeme zájem, skutečnou účast a schopnost použít dovednost. Ani dokončení samo o sobě poslední bod nepotvrzuje.",
      "zh": "课程负责人从报名量改为分别看兴趣、参与和实际应用；完成课程也不直接证明能应用。"
    }
  ],
  "exercises": [
    {
