  "title_zh": "写一份能作决定的提案：新情境检验",
  "version": "2026.10.22.1",
  "unseen_text": [
    {
      "cs": "Sportovní spolek zvažuje nový rezervační systém. Oslovil pouze pravidelné hráče, kteří změnu většinou vítají. Správce navrhuje okamžitý přechod všech týmů. Jiná členka žádá nejprve zkoušku s možností telefonické rezervace pro lidi bez internetu.",
      "zh": "体育社团只问了固定球员，管理员提议全员立即切换预约系统；另一成员要求先试用并保留无网络者电话渠道。"
    }
  ],
  "exercises": [
    {
      "type": "choice",
      "prompt_zh": "关键证据缺口是什么？",
      "stimulus_cs": "",
      "answer": "a",
      "explanation_zh": "资料不足以支持所有人适用。",
      "skill_ids": [
        "reading"
      ],
      "knowledge_points": [
        "c1-report-evidence",
        "c1-passive-accountability"
      ],
      "error_category": "comprehension",
      "options": [
        {
          "id": "a",
          "text": "未覆盖不同使用条件的人"
        },
        {
          "id": "b",
          "text": "无人表示支持"
        },
        {
          "id": "c",
          "text": "新系统无法工作"
        }
      ],
      "scoring_basis": "封闭题以答案核对；解析说明本题边界。",
      "id": "C1-U06-CHECK-E01"
    },
    {
      "type": "writing",
      "prompt_zh": "写三句试行建议，说明责任和检查对象。",
      "stimulus_cs": "",
      "answer": "Navrhuji zkoušku s jedním týmem. Správce bude sledovat úspěšné i nezdařené rezervace. Telefonická možnost zůstane zachována do vyhodnocení.",
      "explanation_zh": "不预设失败，保留可访问性。",
      "skill_ids": [
        "writing"
      ],
      "knowledge_points": [
        "c1-report-evidence",
        "c1-passive-accountability"
      ],
      "error_category": "comprehension",
      "rubric": [
        "回应具体任务，信息不失真",
        "逻辑有衔接，能说明证据与限制",
        "语法与搭配基本准确，语域适合对象",
        "能自主组织语言而非照读范文"
      ],
      "scoring_basis": "开放表达：示范不是唯一答案；依量规自评或人工评阅，未接受人工评阅时不自动判定能力达标。",
      "id": "C1-U06-CHECK-E02"
    },
    {
      "type": "interaction",
      "prompt_zh": "回应“保留电话太麻烦”。",
      "stimulus_cs": "",
      "answer": "Jak velkou dodatečnou práci telefon představuje? Porovnejme ji s počtem lidí, kteří by jinak nemohli rezervovat.",
      "explanation_zh": "将主观抱怨转换为可比较成本与影响。",
      "skill_ids": [
        "interaction"
      ],
      "knowledge_points": [
