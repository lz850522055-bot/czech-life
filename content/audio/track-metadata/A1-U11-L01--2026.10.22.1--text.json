  "units": [
    {
      "text": "To je Petr. Petr dnes připravuje malou oslavu.",
      "index": 0,
      "role": "text",
      "parts": [
        "To je Petr.",
        "Petr dnes připravuje malou oslavu."
      ]
    },
    {
      "text": "Vidím Petra před obchodem. Kupuje chléb a ovoce.",
      "index": 1,
      "role": "text",
      "parts": [
        "Vidím Petra před obchodem.",
        "Kupuje chléb a ovoce."
      ]
    },
    {
      "text": "Telefonuju Petrovi. Ptám se ho, co ještě potřebuje.",
      "index": 2,
      "role": "text",
      "parts": [
        "Telefonuju Petrovi.",
        "Ptám se ho, co ještě potřebuje."
      ]
    },
    {
      "text": "Petr říká: Přijď bez dárku. Máme všechno.",
      "index": 3,
      "role": "text",
      "parts": [
        "Petr říká: Přijď bez dárku.",
        "Máme všechno."
      ]
    },
    {
      "text": "Jdu do obchodu a potom k Petrovi. Mám jen malou tašku.",
      "index": 4,
      "role": "text",
      "parts": [
        "Jdu do obchodu a potom k Petrovi.",
        "Mám jen malou tašku."
      ]
    },
    {
      "text": "U Petra je Jana. Mluvím s Janou o práci a o Praze.",
      "index": 5,
      "role": "text",
      "parts": [
        "U Petra je Jana.",
        "Mluvím s Janou o práci a o Praze."
      ]
    },
    {
      "text": "Petře, kde je voda? Je na stole vedle čaje.",
      "index": 6,
      "role": "text",
      "parts": [
        "Petře, kde je voda?",
        "Je na stole vedle čaje."
      ]
    },
    {
      "text": "Děkuju. Čaj si dám bez cukru. Potom jdu s Petrem ven.",
      "index": 7,
      "role": "text",
      "parts": [
        "Děkuju.",
        "Čaj si dám bez cukru.",
        "Potom jdu s Petrem ven."
      ]
    },
    {
      "text": "Jména se mění, ale pořád mluvíme o stejných lidech.",
      "index": 8,
      "role": "text",
      "parts": [
        "Jména se mění, ale pořád mluvíme o stejných lidech."
      ]
    }
  ],
