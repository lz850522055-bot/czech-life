  "language": "cs-CZ",
  "units": [
    {
      "text": "Ahoj, máš zítra čas? Potřebuju s tebou mluvit.",
      "index": 0,
      "role": "text",
      "parts": [
        "Ahoj, máš zítra čas?",
        "Potřebuju s tebou mluvit."
      ]
    },
    {
      "text": "Zítra je úterý. Dopoledne pracuju, ale odpoledne mám volno.",
      "index": 1,
      "role": "text",
      "parts": [
        "Zítra je úterý.",
        "Dopoledne pracuju, ale odpoledne mám volno."
      ]
    },
    {
      "text": "Můžeme se sejít v šest hodin u kavárny?",
      "index": 2,
      "role": "text",
      "parts": [
        "Můžeme se sejít v šest hodin u kavárny?"
      ]
    },
    {
      "text": "V šest nemůžu. V sedm mám další schůzku. Co v půl šesté?",
      "index": 3,
      "role": "text",
      "parts": [
        "V šest nemůžu.",
        "V sedm mám další schůzku.",
        "Co v půl šesté?"
      ]
    },
    {
      "text": "Půl šesté, tedy sedmnáct třicet? Ano, to je dobré.",
      "index": 4,
      "role": "text",
      "parts": [
        "Půl šesté, tedy sedmnáct třicet?",
        "Ano, to je dobré."
      ]
    },
    {
      "text": "Kavárna je otevřená od devíti do osmnácti. Máme dost času.",
      "index": 5,
      "role": "text",
      "parts": [
        "Kavárna je otevřená od devíti do osmnácti.",
        "Máme dost času."
      ]
    },
    {
      "text": "A kde přesně čekáš? Před vchodem, nebo uvnitř?",
      "index": 6,
      "role": "text",
      "parts": [
        "A kde přesně čekáš?",
        "Před vchodem, nebo uvnitř?"
      ]
    },
    {
      "text": "Před vchodem. Když prší, jsem uvnitř u okna.",
      "index": 7,
      "role": "text",
      "parts": [
        "Před vchodem.",
        "Když prší, jsem uvnitř u okna."
      ]
    },
    {
      "text": "Dobře. V úterý v sedmnáct třicet u kavárny.",
      "index": 8,
      "role": "text",
      "parts": [
        "Dobře.",
        "V úterý v sedmnáct třicet u kavárny."
      ]
    },
    {
      "text": "Ano. Když nemůžeš přijít, napiš mi zprávu.",
      "index": 9,
      "role": "text",
      "parts": [
        "Ano.",
        "Když nemůžeš přijít, napiš mi zprávu."
      ]
    }
  ],
