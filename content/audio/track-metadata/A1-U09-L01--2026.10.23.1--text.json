  "level": "A1",
  "group": "text",
  "language": "cs-CZ",
  "units": [
    {
      "text": "Promiňte, kde je knihovna? Jsem tady poprvé.",
      "index": 0,
      "role": "text",
      "parts": [
        "Promiňte, kde je knihovna?",
        "Jsem tady poprvé."
      ]
    },
    {
      "text": "Knihovna je za parkem. Jděte rovně a potom doleva.",
      "index": 1,
      "role": "text",
      "parts": [
        "Knihovna je za parkem.",
        "Jděte rovně a potom doleva."
      ]
    },
    {
      "text": "Je to daleko? Mám jen půl hodiny.",
      "index": 2,
      "role": "text",
      "parts": [
        "Je to daleko?",
        "Mám jen půl hodiny."
      ]
    },
    {
      "text": "Pěšky asi patnáct minut. Můžete jet také autobusem.",
      "index": 3,
      "role": "text",
      "parts": [
        "Pěšky asi patnáct minut.",
        "Můžete jet také autobusem."
      ]
    },
    {
      "text": "Který autobus tam jede? A kde je zastávka?",
      "index": 4,
      "role": "text",
      "parts": [
        "Který autobus tam jede?",
        "A kde je zastávka?"
      ]
    },
    {
      "text": "Autobus číslo dvanáct. Zastávka je naproti obchodu.",
      "index": 5,
      "role": "text",
      "parts": [
        "Autobus číslo dvanáct.",
        "Zastávka je naproti obchodu."
      ]
    },
    {
      "text": "Kde mám vystoupit?",
      "index": 6,
      "role": "text",
      "parts": [
        "Kde mám vystoupit?"
      ]
    },
    {
      "text": "Na druhé zastávce. Potom přejděte ulici a knihovna je vpravo.",
      "index": 7,
      "role": "text",
      "parts": [
        "Na druhé zastávce.",
        "Potom přejděte ulici a knihovna je vpravo."
      ]
    },
    {
      "text": "Takže dvanáctkou, dvě zastávky a potom vpravo?",
      "index": 8,
      "role": "text",
      "parts": [
        "Takže dvanáctkou, dvě zastávky a potom vpravo?"
      ]
    },
    {
      "text": "Ano. Ale nejdřív bezpečně přejděte ulici.",
      "index": 9,
      "role": "text",
      "parts": [
        "Ano.",
        "Ale nejdřív bezpečně přejděte ulici."
      ]
    },
    {
      "text": "Můžete mi to ukázat na mapě? Ano, tady jsme a tady je knihovna.",
      "index": 10,
      "role": "text",
      "parts": [
        "Můžete mi to ukázat na mapě?",
        "Ano, tady jsme a tady je knihovna."
      ]
    }
  ],
