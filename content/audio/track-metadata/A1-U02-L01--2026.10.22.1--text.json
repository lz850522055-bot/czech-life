  "language": "cs-CZ",
  "units": [
    {
      "text": "Tady je náš malý byt. To je kuchyň a vedle je pokoj.",
      "index": 0,
      "role": "text",
      "parts": [
        "Tady je náš malý byt.",
        "To je kuchyň a vedle je pokoj."
      ]
    },
    {
      "text": "Ten stůl je nový, ale ta židle je stará. To okno je velké.",
      "index": 1,
      "role": "text",
      "parts": [
        "Ten stůl je nový, ale ta židle je stará.",
        "To okno je velké."
      ]
    },
    {
      "text": "Na stole je telefon, kniha a malé rádio. Telefon je černý.",
      "index": 2,
      "role": "text",
      "parts": [
        "Na stole je telefon, kniha a malé rádio.",
        "Telefon je černý."
      ]
    },
    {
      "text": "Kniha je česká. Rádio je bílé a velmi lehké.",
      "index": 3,
      "role": "text",
      "parts": [
        "Kniha je česká.",
        "Rádio je bílé a velmi lehké."
      ]
    },
    {
      "text": "Kdo je na fotografii? To je můj kolega Pavel a moje kolegyně Eva.",
      "index": 4,
      "role": "text",
      "parts": [
        "Kdo je na fotografii?",
        "To je můj kolega Pavel a moje kolegyně Eva."
      ]
    },
    {
      "text": "Pavel je nový učitel. Eva je dobrá lékařka.",
      "index": 5,
      "role": "text",
      "parts": [
        "Pavel je nový učitel.",
        "Eva je dobrá lékařka."
      ]
    },
    {
      "text": "Je ten pokoj volný? Ano, je volný. Ta kuchyň je společná.",
      "index": 6,
      "role": "text",
      "parts": [
        "Je ten pokoj volný?",
        "Ano, je volný.",
        "Ta kuchyň je společná."
      ]
    },
    {
      "text": "Dobře, děkuju. Teď už vím, co je tady nové a co staré.",
      "index": 7,
      "role": "text",
      "parts": [
        "Dobře, děkuju.",
        "Teď už vím, co je tady nové a co staré."
      ]
    }
  ],
