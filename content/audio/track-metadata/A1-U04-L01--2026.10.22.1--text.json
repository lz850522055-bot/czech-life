  "language": "cs-CZ",
  "units": [
    {
      "text": "Dobrý den, prosím vás, kde je informační centrum?",
      "index": 0,
      "role": "text",
      "parts": [
        "Dobrý den, prosím vás, kde je informační centrum?"
      ]
    },
    {
      "text": "Je v prvním patře. Ale teď není otevřené.",
      "index": 1,
      "role": "text",
      "parts": [
        "Je v prvním patře.",
        "Ale teď není otevřené."
      ]
    },
    {
      "text": "Kdy otevírá? Potřebuju mapu a jednu informaci.",
      "index": 2,
      "role": "text",
      "parts": [
        "Kdy otevírá?",
        "Potřebuju mapu a jednu informaci."
      ]
    },
    {
      "text": "Otevírá v deset. Mapu máme i tady. Chcete ji?",
      "index": 3,
      "role": "text",
      "parts": [
        "Otevírá v deset.",
        "Mapu máme i tady.",
        "Chcete ji?"
      ]
    },
    {
      "text": "Ano, prosím. Kolik stojí? A můžu platit kartou?",
      "index": 4,
      "role": "text",
      "parts": [
        "Ano, prosím.",
        "Kolik stojí?",
        "A můžu platit kartou?"
      ]
    },
    {
      "text": "Mapa je zdarma. Nemusíte platit.",
      "index": 5,
      "role": "text",
      "parts": [
        "Mapa je zdarma.",
        "Nemusíte platit."
      ]
    },
    {
      "text": "Děkuju. Nerozumím tomuto slovu. Můžete to napsat?",
      "index": 6,
      "role": "text",
      "parts": [
        "Děkuju.",
        "Nerozumím tomuto slovu.",
        "Můžete to napsat?"
      ]
    },
    {
      "text": "Ano. Tady je název ulice. Není to daleko.",
      "index": 7,
      "role": "text",
      "parts": [
        "Ano.",
        "Tady je název ulice.",
        "Není to daleko."
      ]
    },
    {
      "text": "Výborně. Ještě jednu otázku: můžu tady čekat?",
      "index": 8,
      "role": "text",
      "parts": [
        "Výborně.",
        "Ještě jednu otázku: můžu tady čekat?"
      ]
    },
    {
      "text": "Ano, můžete. Jen tady nesmíte kouřit.",
      "index": 9,
      "role": "text",
      "parts": [
        "Ano, můžete.",
        "Jen tady nesmíte kouřit."
      ]
    },
    {
      "text": "A kde můžu koupit jízdenku? U automatu vedle dveří. Děkuju za pomoc.",
      "index": 10,
      "role": "text",
      "parts": [
        "A kde můžu koupit jízdenku?",
        "U automatu vedle dveří.",
        "Děkuju za pomoc."
      ]
    }
  ],
