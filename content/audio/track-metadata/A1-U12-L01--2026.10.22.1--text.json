  "language": "cs-CZ",
  "units": [
    {
      "text": "Dnes mám zprávu: Vaše zásilka je připravena. Výdejní místo je v ulici Lipová.",
      "index": 0,
      "role": "text",
      "parts": [
        "Dnes mám zprávu: Vaše zásilka je připravena.",
        "Výdejní místo je v ulici Lipová."
      ]
    },
    {
      "text": "Otevírací doba je od deseti do osmnácti. Potřebujete kód nebo doklad.",
      "index": 1,
      "role": "text",
      "parts": [
        "Otevírací doba je od deseti do osmnácti.",
        "Potřebujete kód nebo doklad."
      ]
    },
    {
      "text": "Dobrý den, mám tady zásilku. Jmenuju se Li.",
      "index": 2,
      "role": "text",
      "parts": [
        "Dobrý den, mám tady zásilku.",
        "Jmenuju se Li."
      ]
    },
    {
      "text": "Dobrý den. Jaký máte kód?",
      "index": 3,
      "role": "text",
      "parts": [
        "Dobrý den.",
        "Jaký máte kód?"
      ]
    },
    {
      "text": "Je to šest, dva, osm, čtyři. Můžu ho také ukázat v telefonu.",
      "index": 4,
      "role": "text",
      "parts": [
        "Je to šest, dva, osm, čtyři.",
        "Můžu ho také ukázat v telefonu."
      ]
    },
    {
      "text": "Děkuju. Vidím tady dvě zásilky. Je vaše adresa Lipová dvacet?",
      "index": 5,
      "role": "text",
      "parts": [
        "Děkuju.",
        "Vidím tady dvě zásilky.",
        "Je vaše adresa Lipová dvacet?"
      ]
    },
    {
      "text": "Ne, moje adresa je Lipová dvanáct. Tady je doklad.",
      "index": 6,
      "role": "text",
      "parts": [
        "Ne, moje adresa je Lipová dvanáct.",
        "Tady je doklad."
      ]
    },
    {
      "text": "Dobře, tahle zásilka je vaše. Podepište se tady, prosím.",
      "index": 7,
      "role": "text",
      "parts": [
        "Dobře, tahle zásilka je vaše.",
        "Podepište se tady, prosím."
      ]
    },
    {
      "text": "Ještě prosím: kde je východ? Ta krabice je velká.",
      "index": 8,
      "role": "text",
      "parts": [
        "Ještě prosím: kde je východ?",
        "Ta krabice je velká."
      ]
    },
    {
      "text": "Vpravo. Můžu vám otevřít dveře. Na shledanou.",
      "index": 9,
      "role": "text",
      "parts": [
        "Vpravo.",
        "Můžu vám otevřít dveře.",
        "Na shledanou."
      ]
    }
  ],
