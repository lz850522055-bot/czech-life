  "language": "cs-CZ",
  "units": [
    {
      "text": "Dobrý den, já jsem Li. Jsem z Číny a teď bydlím v Praze.",
      "index": 0,
      "role": "text",
      "parts": [
        "Dobrý den, já jsem Li.",
        "Jsem z Číny a teď bydlím v Praze."
      ]
    },
    {
      "text": "Dobrý den, já jsem Jana Nováková. Těší mě. Jste tady nový?",
      "index": 1,
      "role": "text",
      "parts": [
        "Dobrý den, já jsem Jana Nováková.",
        "Těší mě.",
        "Jste tady nový?"
      ]
    },
    {
      "text": "Ano, jsem tady nový. Mluvím trochu česky, ale nerozumím všemu.",
      "index": 2,
      "role": "text",
      "parts": [
        "Ano, jsem tady nový.",
        "Mluvím trochu česky, ale nerozumím všemu."
      ]
    },
    {
      "text": "To nevadí. Můžu mluvit pomalu. Jak se jmenujete příjmením?",
      "index": 3,
      "role": "text",
      "parts": [
        "To nevadí.",
        "Můžu mluvit pomalu.",
        "Jak se jmenujete příjmením?"
      ]
    },
    {
      "text": "Moje příjmení je Li. A jak vám mám říkat?",
      "index": 4,
      "role": "text",
      "parts": [
        "Moje příjmení je Li.",
        "A jak vám mám říkat?"
      ]
    },
    {
      "text": "Říkejte mi Jana. Jsme sousedé. Tady je můj manžel Petr.",
      "index": 5,
      "role": "text",
      "parts": [
        "Říkejte mi Jana.",
        "Jsme sousedé.",
        "Tady je můj manžel Petr."
      ]
    },
    {
      "text": "Dobrý den, pane Nováku. Těší mě.",
      "index": 6,
      "role": "text",
      "parts": [
        "Dobrý den, pane Nováku.",
        "Těší mě."
      ]
    },
    {
      "text": "Taky mě těší. Když nerozumíte, řekněte: „Prosím, ještě jednou.“",
      "index": 7,
      "role": "text",
      "parts": [
        "Taky mě těší.",
        "Když nerozumíte, řekněte: „Prosím, ještě jednou.“"
      ]
    },
    {
      "text": "Děkuju. Teď už rozumím. Na shledanou.",
      "index": 8,
      "role": "text",
      "parts": [
        "Děkuju.",
        "Teď už rozumím.",
        "Na shledanou."
      ]
    }
  ],
