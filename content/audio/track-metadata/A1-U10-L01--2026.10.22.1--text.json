  "language": "cs-CZ",
  "units": [
    {
      "text": "Dnes nemám moc energie. Mám hlad a trochu žízeň.",
      "index": 0,
      "role": "text",
      "parts": [
        "Dnes nemám moc energie.",
        "Mám hlad a trochu žízeň."
      ]
    },
    {
      "text": "Chceš něco k jídlu? Máme chléb, sýr a teplou polévku.",
      "index": 1,
      "role": "text",
      "parts": [
        "Chceš něco k jídlu?",
        "Máme chléb, sýr a teplou polévku."
      ]
    },
    {
      "text": "Polévku, prosím. A potřebuju vodu. Je mi také trochu zima.",
      "index": 2,
      "role": "text",
      "parts": [
        "Polévku, prosím.",
        "A potřebuju vodu.",
        "Je mi také trochu zima."
      ]
    },
    {
      "text": "Můžu zavřít okno. Chceš si na chvíli sednout?",
      "index": 3,
      "role": "text",
      "parts": [
        "Můžu zavřít okno.",
        "Chceš si na chvíli sednout?"
      ]
    },
    {
      "text": "Ano, děkuju. Jsem unavený, protože dnes hodně pracuju.",
      "index": 4,
      "role": "text",
      "parts": [
        "Ano, děkuju.",
        "Jsem unavený, protože dnes hodně pracuju."
      ]
    },
    {
      "text": "Bolí tě hlava, nebo jen potřebuješ odpočívat?",
      "index": 5,
      "role": "text",
      "parts": [
        "Bolí tě hlava, nebo jen potřebuješ odpočívat?"
      ]
    },
    {
      "text": "Trochu mě bolí hlava. Nechci teď žádnou kávu.",
      "index": 6,
      "role": "text",
      "parts": [
        "Trochu mě bolí hlava.",
        "Nechci teď žádnou kávu."
      ]
    },
    {
      "text": "Dobře. Tady je voda. Když potřebuješ pomoc, řekni mi to.",
      "index": 7,
      "role": "text",
      "parts": [
        "Dobře.",
        "Tady je voda.",
        "Když potřebuješ pomoc, řekni mi to."
      ]
    },
    {
      "text": "Děkuju. Už je mi lépe. Teď chci chvíli odpočívat.",
      "index": 8,
      "role": "text",
      "parts": [
        "Děkuju.",
        "Už je mi lépe.",
        "Teď chci chvíli odpočívat."
      ]
    },
    {
      "text": "Večer už nikam nejdu. Zůstanu doma a zavolám kamarádovi.",
      "index": 9,
      "role": "text",
      "parts": [
        "Večer už nikam nejdu.",
        "Zůstanu doma a zavolám kamarádovi."
      ]
    }
  ],
