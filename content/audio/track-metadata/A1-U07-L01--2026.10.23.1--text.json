  "language": "cs-CZ",
  "units": [
    {
      "text": "To je moje rodina. Na fotografii je moje sestra, její manžel a jejich dcera.",
      "index": 0,
      "role": "text",
      "parts": [
        "To je moje rodina.",
        "Na fotografii je moje sestra, její manžel a jejich dcera."
      ]
    },
    {
      "text": "Sestra se jmenuje Lin. Pracuje v obchodě a má ráda svou práci.",
      "index": 1,
      "role": "text",
      "parts": [
        "Sestra se jmenuje Lin.",
        "Pracuje v obchodě a má ráda svou práci."
      ]
    },
    {
      "text": "Její manžel je kuchař. Rád vaří, ale doma někdy vaří i sestra.",
      "index": 2,
      "role": "text",
      "parts": [
        "Její manžel je kuchař.",
        "Rád vaří, ale doma někdy vaří i sestra."
      ]
    },
    {
      "text": "Jejich dcera chodí do školy. Ráda čte a kreslí.",
      "index": 3,
      "role": "text",
      "parts": [
        "Jejich dcera chodí do školy.",
        "Ráda čte a kreslí."
      ]
    },
    {
      "text": "Já bydlím sám. Ve volném čase rád chodím ven a poslouchám hudbu.",
      "index": 4,
      "role": "text",
      "parts": [
        "Já bydlím sám.",
        "Ve volném čase rád chodím ven a poslouchám hudbu."
      ]
    },
    {
      "text": "Můj kamarád Pavel má rád sport. Každou sobotu hraje fotbal.",
      "index": 5,
      "role": "text",
      "parts": [
        "Můj kamarád Pavel má rád sport.",
        "Každou sobotu hraje fotbal."
      ]
    },
    {
      "text": "Nemám moc času na sport, ale rád se s ním procházím.",
      "index": 6,
      "role": "text",
      "parts": [
        "Nemám moc času na sport, ale rád se s ním procházím."
      ]
    },
    {
      "text": "A co vy? Máte sourozence? Co rád děláte o víkendu?",
      "index": 7,
      "role": "text",
      "parts": [
        "A co vy?",
        "Máte sourozence?",
        "Co rád děláte o víkendu?"
      ]
    },
    {
      "text": "O osobních věcech mluvíme jen tehdy, když chceme.",
      "index": 8,
      "role": "text",
      "parts": [
        "O osobních věcech mluvíme jen tehdy, když chceme."
      ]
    }
  ],
