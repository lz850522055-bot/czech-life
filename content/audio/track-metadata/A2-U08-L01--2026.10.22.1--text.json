  "language": "cs-CZ",
  "units": [
    {
      "text": "Dobrý den, tady Li. Volám kvůli zítřejší schůzce. Můžu prosím mluvit s paní Novákovou?",
      "index": 0,
      "role": "text",
      "parts": [
        "Dobrý den, tady Li.",
        "Volám kvůli zítřejší schůzce.",
        "Můžu prosím mluvit s paní Novákovou?"
      ]
    },
    {
      "text": "Dobrý den. Paní Nováková teď nemůže k telefonu. Můžu jí něco vyřídit?",
      "index": 1,
      "role": "text",
      "parts": [
        "Dobrý den.",
        "Paní Nováková teď nemůže k telefonu.",
        "Můžu jí něco vyřídit?"
      ]
    },
    {
      "text": "Ano, prosím. Potřebuju potvrdit čas a adresu. V poslední zprávě bylo deset hodin, ale předtím jsme mluvili o jedenácté.",
      "index": 2,
      "role": "text",
      "parts": [
        "Ano, prosím.",
        "Potřebuju potvrdit čas a adresu.",
        "V poslední zprávě bylo deset hodin, ale předtím jsme mluvili o jedenácté."
      ]
    },
    {
      "text": "Podívám se do kalendáře. Vidím tady schůzku ve čtvrtek v deset hodin, ulice Lesní číslo patnáct.",
      "index": 3,
      "role": "text",
      "parts": [
        "Podívám se do kalendáře.",
        "Vidím tady schůzku ve čtvrtek v deset hodin, ulice Lesní číslo patnáct."
      ]
    },
    {
      "text": "Promiňte, slyším vás špatně. Říkáte patnáct, nebo padesát? A schůzka je zítra, tedy ve čtvrtek?",
      "index": 4,
      "role": "text",
      "parts": [
        "Promiňte, slyším vás špatně.",
        "Říkáte patnáct, nebo padesát?",
        "A schůzka je zítra, tedy ve čtvrtek?"
      ]
    },
    {
      "text": "Patnáct, jedna pět. Ano, ve čtvrtek. Pošlu vám potvrzení zprávou, aby nedošlo k omylu.",
      "index": 5,
      "role": "text",
      "parts": [
        "Patnáct, jedna pět.",
        "Ano, ve čtvrtek.",
        "Pošlu vám potvrzení zprávou, aby nedošlo k omylu."
      ]
    },
    {
      "text": "Děkuju. Moje číslo máte, nebo ho mám zopakovat?",
      "index": 6,
      "role": "text",
      "parts": [
        "Děkuju.",
        "Moje číslo máte, nebo ho mám zopakovat?"
      ]
    },
    {
      "text": "Číslo vidím. Prosím odpovězte na zprávu, až ji dostanete. Pokud něco nesouhlasí, zavolejte znovu.",
      "index": 7,
      "role": "text",
      "parts": [
        "Číslo vidím.",
        "Prosím odpovězte na zprávu, až ji dostanete.",
        "Pokud něco nesouhlasí, zavolejte znovu."
      ]
    },
    {
      "text": "Dobře. Ještě prosím vyřiďte paní Novákové, že přinesu podklady. Teď už je mi všechno jasné.",
      "index": 8,
      "role": "text",
      "parts": [
        "Dobře.",
        "Ještě prosím vyřiďte paní Novákové, že přinesu podklady.",
        "Teď už je mi všechno jasné."
      ]
    },
    {
      "text": "Na shledanou a děkuju za pomoc.",
      "index": 9,
      "role": "text",
      "parts": [
        "Na shledanou a děkuju za pomoc."
      ]
    },
    {
      "text": "Po hovoru si zapíšu potvrzený čas a počkám na zprávu. Teprve potom považuju domluvu za jasnou.",
      "index": 10,
      "role": "text",
      "parts": [
        "Po hovoru si zapíšu potvrzený čas a počkám na zprávu.",
        "Teprve potom považuju domluvu za jasnou."
      ]
    }
  ],
