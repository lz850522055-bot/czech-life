  "language": "cs-CZ",
  "units": [
    {
      "text": "Dobrý den. Kolik stojí ten hrnek?",
      "index": 0,
      "role": "text",
      "parts": [
        "Dobrý den.",
        "Kolik stojí ten hrnek?"
      ]
    },
    {
      "text": "Jeden hrnek stojí osmdesát korun. Dva hrnky stojí sto šedesát korun.",
      "index": 1,
      "role": "text",
      "parts": [
        "Jeden hrnek stojí osmdesát korun.",
        "Dva hrnky stojí sto šedesát korun."
      ]
    },
    {
      "text": "A ty malé lžičky? Potřebuju tři kusy.",
      "index": 2,
      "role": "text",
      "parts": [
        "A ty malé lžičky?",
        "Potřebuju tři kusy."
      ]
    },
    {
      "text": "Jedna lžička stojí dvacet korun. Tři lžičky stojí šedesát.",
      "index": 3,
      "role": "text",
      "parts": [
        "Jedna lžička stojí dvacet korun.",
        "Tři lžičky stojí šedesát."
      ]
    },
    {
      "text": "Dobře. Mám dvě stě korun. Vezmu jeden hrnek a tři lžičky.",
      "index": 4,
      "role": "text",
      "parts": [
        "Dobře.",
        "Mám dvě stě korun.",
        "Vezmu jeden hrnek a tři lžičky."
      ]
    },
    {
      "text": "To je celkem sto čtyřicet korun. Chcete tašku za pět korun?",
      "index": 5,
      "role": "text",
      "parts": [
        "To je celkem sto čtyřicet korun.",
        "Chcete tašku za pět korun?"
      ]
    },
    {
      "text": "Ne, děkuju. Mám vlastní tašku. Platím dvěma sty.",
      "index": 6,
      "role": "text",
      "parts": [
        "Ne, děkuju.",
        "Mám vlastní tašku.",
        "Platím dvěma sty."
      ]
    },
    {
      "text": "Tady máte šedesát korun zpátky a účtenku.",
      "index": 7,
      "role": "text",
      "parts": [
        "Tady máte šedesát korun zpátky a účtenku."
      ]
    },
    {
      "text": "Děkuju. Cena je za kus, ne za celé balení, ano?",
      "index": 8,
      "role": "text",
      "parts": [
        "Děkuju.",
        "Cena je za kus, ne za celé balení, ano?"
      ]
    },
    {
      "text": "Ano, přesně tak.",
      "index": 9,
      "role": "text",
      "parts": [
        "Ano, přesně tak."
      ]
    }
  ],
  "text_sha256": "9f3e64dfe5b2b2b691eea49e67ee24a757ce2cf488c946228f8869ebdd22cc39",
