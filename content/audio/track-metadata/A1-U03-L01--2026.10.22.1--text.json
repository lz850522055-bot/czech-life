  "language": "cs-CZ",
  "units": [
    {
      "text": "Ráno vstávám v sedm a doma snídám. Potom pracuju v malé firmě.",
      "index": 0,
      "role": "text",
      "parts": [
        "Ráno vstávám v sedm a doma snídám.",
        "Potom pracuju v malé firmě."
      ]
    },
    {
      "text": "Moje kolegyně Eva mluví s lidmi a já píšu krátké zprávy.",
      "index": 1,
      "role": "text",
      "parts": [
        "Moje kolegyně Eva mluví s lidmi a já píšu krátké zprávy."
      ]
    },
    {
      "text": "Petr má obchod. Prodává čaj, kávu a malé dárky.",
      "index": 2,
      "role": "text",
      "parts": [
        "Petr má obchod.",
        "Prodává čaj, kávu a malé dárky."
      ]
    },
    {
      "text": "Co děláš ty? Studuješ, nebo pracuješ?",
      "index": 3,
      "role": "text",
      "parts": [
        "Co děláš ty?",
        "Studuješ, nebo pracuješ?"
      ]
    },
    {
      "text": "Teď pracuju, ale večer se učím česky. Každý den čtu krátký text.",
      "index": 4,
      "role": "text",
      "parts": [
        "Teď pracuju, ale večer se učím česky.",
        "Každý den čtu krátký text."
      ]
    },
    {
      "text": "My obvykle obědváme spolu. Eva pije vodu a já piju čaj.",
      "index": 5,
      "role": "text",
      "parts": [
        "My obvykle obědváme spolu.",
        "Eva pije vodu a já piju čaj."
      ]
    },
    {
      "text": "Odpoledne máme čas na telefon. Potřebujeme jednu informaci.",
      "index": 6,
      "role": "text",
      "parts": [
        "Odpoledne máme čas na telefon.",
        "Potřebujeme jednu informaci."
      ]
    },
    {
      "text": "Večer už nepracuju. Vařím, poslouchám hudbu a odpočívám.",
      "index": 7,
      "role": "text",
      "parts": [
        "Večer už nepracuju.",
        "Vařím, poslouchám hudbu a odpočívám."
      ]
    },
    {
      "text": "O víkendu obvykle nepracuju. Mám čas na přátele a na rodinu.",
      "index": 8,
      "role": "text",
      "parts": [
        "O víkendu obvykle nepracuju.",
        "Mám čas na přátele a na rodinu."
      ]
    }
  ],
