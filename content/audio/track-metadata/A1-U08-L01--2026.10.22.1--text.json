  "level": "A1",
  "group": "text",
  "language": "cs-CZ",
  "units": [
    {
      "text": "Dobrý den, chtěl bych jednu kávu a malou vodu.",
      "index": 0,
      "role": "text",
      "parts": [
        "Dobrý den, chtěl bych jednu kávu a malou vodu."
      ]
    },
    {
      "text": "Kávu s mlékem? A vodu perlivou, nebo neperlivou?",
      "index": 1,
      "role": "text",
      "parts": [
        "Kávu s mlékem?",
        "A vodu perlivou, nebo neperlivou?"
      ]
    },
    {
      "text": "Kávu bez mléka, prosím. Vodu neperlivou.",
      "index": 2,
      "role": "text",
      "parts": [
        "Kávu bez mléka, prosím.",
        "Vodu neperlivou."
      ]
    },
    {
      "text": "Máte také něco malého k jídlu? Nemám moc času.",
      "index": 3,
      "role": "text",
      "parts": [
        "Máte také něco malého k jídlu?",
        "Nemám moc času."
      ]
    },
    {
      "text": "Máme čerstvý chléb, polévku a zeleninový salát.",
      "index": 4,
      "role": "text",
      "parts": [
        "Máme čerstvý chléb, polévku a zeleninový salát."
      ]
    },
    {
      "text": "Vezmu si polévku. Je v ní maso?",
      "index": 5,
      "role": "text",
      "parts": [
        "Vezmu si polévku.",
        "Je v ní maso?"
      ]
    },
    {
      "text": "Ne, je zeleninová. Ale obsahuje mléko.",
      "index": 6,
      "role": "text",
      "parts": [
        "Ne, je zeleninová.",
        "Ale obsahuje mléko."
      ]
    },
    {
      "text": "Děkuju za informaci. Tak raději jen salát.",
      "index": 7,
      "role": "text",
      "parts": [
        "Děkuju za informaci.",
        "Tak raději jen salát."
      ]
    },
    {
      "text": "Dobře. Celkem dvě stě deset korun. Platíte hotově, nebo kartou?",
      "index": 8,
      "role": "text",
      "parts": [
        "Dobře.",
        "Celkem dvě stě deset korun.",
        "Platíte hotově, nebo kartou?"
      ]
    },
    {
      "text": "Kartou, prosím. A prosím účtenku.",
      "index": 9,
      "role": "text",
      "parts": [
        "Kartou, prosím.",
        "A prosím účtenku."
      ]
    },
    {
      "text": "Chcete si jídlo vzít s sebou? Ano, prosím, dnes nemůžu zůstat dlouho.",
      "index": 10,
      "role": "text",
      "parts": [
        "Chcete si jídlo vzít s sebou?",
        "Ano, prosím, dnes nemůžu zůstat dlouho."
      ]
    }
  ],
